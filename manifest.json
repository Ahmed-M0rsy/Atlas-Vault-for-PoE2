{
  "manifest_version": 3,
  "name": "Atlas Vault – PoE2 Build Manager",
  "version": "1.0.0",
  "description": "Save and organize Path of Exile 2 builds from Mobalytics into folders with a pinned Table of Contents.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Atlas Vault – PoE2 Build Manager",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://mobalytics.gg/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mobalytics.gg/poe-2/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
